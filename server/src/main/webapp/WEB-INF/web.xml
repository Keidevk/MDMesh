<!DOCTYPE web-app PUBLIC
        "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
    <display-name>Headwind MDM</display-name>

    <!-- A path that routing would read differently from the security filters (";" path parameters, encoded "/", "\",
         ";" or ".", "//", "." and ".." segments): 400. Mapped first, before every other filter. -->
    <filter>
        <filter-name>ambiguous-path</filter-name>
        <filter-class>com.hmdm.rest.filter.AmbiguousPathFilter</filter-class>
    </filter>
    <!-- Browser security headers (nosniff, no framing, Referrer-Policy; HSTS when base.url is https) on every response:
         on Docker the edge sets them too, on native installs this is where they come from. Mapped second. -->
    <filter>
        <filter-name>security-headers</filter-name>
        <filter-class>com.hmdm.rest.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <!-- Headwind launcher device routes: 404 unless the legacy.device.api context parameter is 1 (mapped third). -->
    <filter>
        <filter-name>legacy-device-api</filter-name>
        <filter-class>com.hmdm.rest.filter.LegacyDeviceApiFilter</filter-class>
    </filter>
    <filter>
        <filter-name>guice-filter</filter-name>
        <filter-class>com.google.inject.servlet.GuiceFilter</filter-class>
    </filter>

    <filter>
        <filter-name>HMDMApplication</filter-name>
        <filter-class>org.glassfish.jersey.servlet.ServletContainer</filter-class>
        <init-param>
            <param-name>javax.ws.rs.Application</param-name>
            <param-value>com.hmdm.HMDMApplication</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>ambiguous-path</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>security-headers</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>legacy-device-api</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>guice-filter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>HMDMApplication</filter-name>
        <url-pattern>/rest/*</url-pattern>
    </filter-mapping>

    <listener>
        <listener-class>com.hmdm.guice.Initializer</listener-class>
    </listener>

    <listener>
        <listener-class>com.hmdm.rest.AgentWakeBootstrap</listener-class>
    </listener>

    <!-- Same-origin passthrough to the loopback updater supervisor (native installs; on Docker,
         Caddy routes /update/* before Tomcat ever sees it, so this is inert there). -->
    <servlet>
        <servlet-name>update-proxy</servlet-name>
        <servlet-class>com.hmdm.rest.UpdateProxyServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>update-proxy</servlet-name>
        <url-pattern>/update/*</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>1440</session-timeout>
    </session-config>
</web-app>
